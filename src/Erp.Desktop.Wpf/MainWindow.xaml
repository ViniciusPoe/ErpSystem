<Window x:Class="Erp.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERP — Gestao Comercial"
        Height="780"
        Width="1300"
        MinHeight="640"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#EDF1F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Margin="12" CornerRadius="12" Background="#102635">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <!-- Logo / Titulo -->
                    <StackPanel Margin="4,8,4,16">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="ERP"/>
                        <TextBlock FontSize="12" Foreground="#7AAAC4" Text="Gestao Comercial"/>
                    </StackPanel>

                    <!-- Cadastros -->
                    <TextBlock Text="CADASTROS" FontSize="10" FontWeight="SemiBold" Foreground="#4A7A94"
                               Margin="4,0,0,4"/>
                    <Button Style="{StaticResource SidebarButton}" Click="CustomersMenu_Click">Clientes</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="ProductsMenu_Click">Produtos</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="ProductClassificationsMenu_Click" Margin="20,0,0,0" FontSize="11">Classificacoes de Produto</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="ProductBrandsMenu_Click" Margin="20,0,0,0" FontSize="11">Marcas de Produto</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="CarriersMenu_Click">Transportadoras</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="SuppliersMenu_Click">Fornecedores</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="MunicipalitiesMenu_Click">Municipios</Button>

                    <!-- Vendas -->
                    <TextBlock Text="VENDAS" FontSize="10" FontWeight="SemiBold" Foreground="#4A7A94"
                               Margin="4,14,0,4"/>
                    <Button Style="{StaticResource SidebarButton}" Click="QuotesMenu_Click">Orcamentos</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="OrdersMenu_Click">Pedidos</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="InvoicesMenu_Click">Notas Fiscais</Button>

                    <!-- Compras -->
                    <TextBlock Text="COMPRAS" FontSize="10" FontWeight="SemiBold" Foreground="#4A7A94"
                               Margin="4,14,0,4"/>
                    <Button Style="{StaticResource SidebarButton}" Click="PurchaseRequestsMenu_Click">Solicitacoes de Compra</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="PurchaseOrdersMenu_Click">Ordem de Compra</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="PurchasesMenu_Click">Compras Realizadas</Button>

                    <!-- Financeiro -->
                    <TextBlock Text="FINANCEIRO" FontSize="10" FontWeight="SemiBold" Foreground="#4A7A94"
                               Margin="4,14,0,4"/>
                    <Button Style="{StaticResource SidebarButton}" Click="AccountsReceivableMenu_Click">Contas a Receber</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="AccountsPayableMenu_Click">Contas a Pagar</Button>

                    <!-- Estoque -->
                    <TextBlock Text="ESTOQUE" FontSize="10" FontWeight="SemiBold" Foreground="#4A7A94"
                               Margin="4,14,0,4"/>
                    <Button Style="{StaticResource SidebarButton}" Click="StockBalancesMenu_Click">Saldo em Estoque</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="StockEntriesMenu_Click">Entradas</Button>
                    <Button Style="{StaticResource SidebarButton}" Click="StockOutputsMenu_Click">Saidas</Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Area de conteudo -->
        <Border Grid.Column="1" Margin="0,12,12,12" Padding="20" CornerRadius="12" Background="White">
            <ContentControl x:Name="ScreenHost" />
        </Border>
    </Grid>
</Window>
