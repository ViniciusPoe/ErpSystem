<UserControl x:Class="Erp.Desktop.Wpf.Views.QuotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Orcamentos</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontWeight="SemiBold" Foreground="#132A3A" Margin="4,0,4,6">Novo Orcamento</TextBlock>
                <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Cliente *</TextBlock><ComboBox x:Name="CustomerComboBox"/></StackPanel>
                <UniformGrid Columns="4" Margin="0,4,0,0">
                    <StackPanel Margin="4"><TextBlock>Produto</TextBlock><ComboBox x:Name="ProductComboBox" SelectionChanged="ProductComboBox_SelectionChanged"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Quantidade</TextBlock><TextBox x:Name="QuantityTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Unitario</TextBlock><TextBox x:Name="UnitPriceTextBox"/></StackPanel>
                    <StackPanel Margin="4" VerticalAlignment="Bottom"><Button Padding="10,6" Click="AddItemButton_Click">Adicionar Item</Button></StackPanel>
                </UniformGrid>

                <DataGrid x:Name="DraftItemsGrid" Margin="4,8,4,4" Height="130" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto"  Binding="{Binding Description}"                   Width="*"/>
                        <DataGridTextColumn Header="Qtd"      Binding="{Binding Quantity}"                      Width="80"/>
                        <DataGridTextColumn Header="Unitario" Binding="{Binding UnitPrice, StringFormat=N2}"    Width="110"/>
                        <DataGridTextColumn Header="Total"    Binding="{Binding LineTotal, StringFormat=N2}"    Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <UniformGrid Columns="3">
                    <StackPanel Margin="4"><TextBlock>Desconto (%)</TextBlock><TextBox x:Name="DiscountTextBox" Text="0" TextChanged="DiscountTextBox_TextChanged"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Subtotal</TextBlock><TextBlock x:Name="SubtotalTextBlock" FontSize="14">0,00</TextBlock></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Total</TextBlock><TextBlock x:Name="TotalTextBlock" FontSize="14" Foreground="#1565C0">0,00</TextBlock></StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,8,4,0">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button Padding="12,6" Style="{StaticResource PrimaryButton}" Click="SaveQuoteButton_Click">Salvar</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="QuotesGrid" SelectionChanged="QuotesGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="APROVADO">
                            <Setter Property="Foreground" Value="#2E7D32"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="REPROVADO">
                            <Setter Property="Foreground" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Numero"  Binding="{Binding Number}"                                     Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}"                               Width="*"/>
                <DataGridTextColumn Header="Total"   Binding="{Binding TotalAmount, StringFormat=C2}"               Width="130"/>
                <DataGridTextColumn Header="Status"  Binding="{Binding Status}"                                     Width="110"/>
                <DataGridTextColumn Header="Criado"  Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"  Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
