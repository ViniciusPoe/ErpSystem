<UserControl x:Class="Erp.Desktop.Wpf.Views.AccountsReceivableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Financeiro - Contas a Receber</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#132A3A" Margin="0,0,0,6">Nova Conta a Receber</TextBlock>
                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock>Cliente</TextBlock><ComboBox x:Name="CustomerComboBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Valor total *</TextBlock><TextBox x:Name="AmountTextBox"/></StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock>Cond. Pagamento *</TextBlock>
                        <ComboBox x:Name="PaymentTermComboBox">
                            <ComboBoxItem Tag="A_VISTA" IsSelected="True">A Vista</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60">30/60 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60/90">30/60/90 dias</ComboBoxItem>
                            <ComboBoxItem Tag="7/14/21/28">Semanal (7/14/21/28)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="4"><TextBlock>Base vencimento</TextBlock><DatePicker x:Name="DueDatePicker"/></StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button Padding="12,6" Style="{StaticResource PrimaryButton}" Click="SaveReceivableButton_Click">Salvar</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ReceivablesGrid" Margin="0,0,0,10" SelectionChanged="ReceivablesGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="PAGO">
                            <Setter Property="Foreground" Value="#AAA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding OrderId}" Width="80"/>
                <DataGridTextColumn Header="NF" Binding="{Binding InvoiceId}" Width="70"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Parcela" Binding="{Binding InstallmentNumber}" Width="70"/>
                <DataGridTextColumn Header="Vencimento" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding Amount, StringFormat=C2}" Width="110"/>
                <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentTerm}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="EditActionsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
            <Button Padding="12,6" Style="{StaticResource SuccessButton}" Click="MarkPaidButton_Click">Marcar como Recebido</Button>
        </StackPanel>
    </Grid>
</UserControl>
