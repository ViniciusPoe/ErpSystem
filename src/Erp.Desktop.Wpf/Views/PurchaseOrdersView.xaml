<UserControl x:Class="Erp.Desktop.Wpf.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Ordem de Compra</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontWeight="SemiBold" Foreground="#132A3A" Margin="0,0,0,6">Nova Compra Direta</TextBlock>
                <TextBlock x:Name="RequestHintText" Margin="0,0,0,6" Foreground="#2F4A5D" Visibility="Collapsed"/>

                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Produto *</TextBlock><ComboBox x:Name="ProductComboBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Fornecedor *</TextBlock><ComboBox x:Name="SupplierComboBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Quantidade *</TextBlock><TextBox x:Name="QtyTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Valor Unitario *</TextBlock><TextBox x:Name="UnitPriceTextBox"/></StackPanel>
                </UniformGrid>

                <UniformGrid Columns="3">
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">Cond. Pagamento *</TextBlock>
                        <ComboBox x:Name="PaymentTermComboBox">
                            <ComboBoxItem Tag="A_VISTA" IsSelected="True">A Vista</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60">30/60 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60/90">30/60/90 dias</ComboBoxItem>
                            <ComboBoxItem Tag="7/14/21/28">Semanal (7/14/21/28)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="4"><TextBlock>Observacao</TextBlock><TextBox x:Name="NotesTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Total</TextBlock><TextBlock x:Name="TotalTextBlock" FontSize="14" Foreground="#1565C0">0,00</TextBlock></StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button x:Name="RejectRequestButton" Margin="0,0,8,0" Padding="12,6" Style="{StaticResource DangerButton}" Click="RejectRequestButton_Click" Visibility="Collapsed">Recusar Solicitacao</Button>
                    <Button x:Name="SaveButton" Padding="12,6" Style="{StaticResource SuccessButton}" Click="SaveButton_Click">Gerar Compra</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="UnifiedGrid" SelectionChanged="UnifiedGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisplayStatus}" Value="AGUARDANDO_ENTREGA">
                            <Setter Property="Foreground" Value="#F9A825"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayStatus}" Value="ENTREGUE">
                            <Setter Property="Foreground" Value="#2E7D32"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayStatus}" Value="RECUSADA">
                            <Setter Property="Foreground" Value="#C62828"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayStatus}" Value="CANCELADA">
                            <Setter Property="Foreground" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Origem" Binding="{Binding SourceLabel}" Width="130"/>
                <DataGridTextColumn Header="Solicitacao" Binding="{Binding RequestLabel}" Width="90"/>
                <DataGridTextColumn Header="Produto" Binding="{Binding ProductSku}" Width="150"/>
                <DataGridTextColumn Header="Fornecedor" Binding="{Binding SupplierName}" Width="*"/>
                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Vlr Unit" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Aprovacao" Binding="{Binding ApprovalStatus}" Width="110"/>
                <DataGridTextColumn Header="Entrega" Binding="{Binding DeliveryStatus}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
