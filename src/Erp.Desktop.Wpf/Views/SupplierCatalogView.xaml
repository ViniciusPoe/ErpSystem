<UserControl x:Class="Erp.Desktop.Wpf.Views.SupplierCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Cadastro de Fornecedores</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="NewButton" Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <TextBox x:Name="SearchTextBox" Width="260" Padding="8,4" TextChanged="SearchTextBox_TextChanged" ToolTip="Buscar por codigo, nome, cidade ou CNPJ"/>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="2" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="FormTitle" FontWeight="SemiBold" Foreground="#132A3A" Margin="0,0,0,6">Novo Fornecedor</TextBlock>

                <!-- Row 1: Codigo, Nome, CNPJ, Contato -->
                <UniformGrid Columns="4" Margin="0,0,0,0">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Codigo * (automatico)</TextBlock><TextBox x:Name="CodeTextBox" MaxLength="30" IsReadOnly="True" Background="#EEEEEE"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Nome/Razao Social *</TextBlock><TextBox x:Name="NameTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">CNPJ * (somente numeros)</TextBlock><TextBox x:Name="TaxIdTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Contato</TextBlock><TextBox x:Name="ContactTextBox"/></StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="4,2,4,0">
                    <CheckBox x:Name="IsActiveCheckBox" Content="Cadastro ativo" IsChecked="True"/>
                </StackPanel>

                <!-- Row 2: Email, Telefone, CEP, Municipio -->
                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Email</TextBlock><TextBox x:Name="EmailTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Telefone (somente numeros)</TextBlock><TextBox x:Name="PhoneTextBox"/></StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">CEP (somente numeros)</TextBlock>
                        <DockPanel>
                            <Button x:Name="SearchCepButton" DockPanel.Dock="Right" Padding="8,0" Margin="4,0,0,0" Click="SearchCepButton_Click" ToolTip="Buscar CEP" AutomationProperties.Name="Buscar CEP">Buscar CEP</Button>
                            <TextBox x:Name="ZipCodeTextBox"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">Municipio</TextBlock>
                        <ComboBox x:Name="MunicipalityComboBox" DisplayMemberPath="Display" SelectedValuePath="Id" SelectionChanged="MunicipalityComboBox_SelectionChanged"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Row 3: Endereco, Numero, Bairro, Cidade/UF -->
                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Endereco</TextBlock><TextBox x:Name="StreetTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Numero</TextBlock><TextBox x:Name="NumberTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Bairro</TextBlock><TextBox x:Name="DistrictTextBox"/></StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">Cidade / UF</TextBlock>
                        <DockPanel>
                            <TextBox x:Name="StateTextBox" DockPanel.Dock="Right" MaxLength="2" Width="50" Margin="4,0,0,0" IsReadOnly="True" Background="#EEEEEE"/>
                            <TextBox x:Name="CityTextBox" IsReadOnly="True" Background="#EEEEEE"/>
                        </DockPanel>
                    </StackPanel>
                </UniformGrid>

                <!-- Row 4: Pedido Minimo, Segmento -->
                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Pedido Minimo (R$)</TextBlock><TextBox x:Name="MinimumOrderTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Segmento</TextBlock><ComboBox x:Name="SegmentComboBox" IsEditable="True"/></StackPanel>
                </UniformGrid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,8,4,0">
                    <Button x:Name="CancelFormButton" Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button x:Name="SaveButton" Padding="12,6" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click">Salvar</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" x:Name="SuppliersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SuppliersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Codigo" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Segmento" Binding="{Binding Segment}" Width="120"/>
                <DataGridTextColumn Header="Pedido Min." Binding="{Binding MinimumOrder, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Cidade" Binding="{Binding City}" Width="140"/>
                <DataGridTextColumn Header="UF" Binding="{Binding State}" Width="50"/>
                <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding IsActive}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
