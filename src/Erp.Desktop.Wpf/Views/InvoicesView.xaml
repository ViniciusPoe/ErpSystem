<UserControl x:Class="Erp.Desktop.Wpf.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Notas Fiscais</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="NewButton" Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#132A3A" Margin="0,0,0,6">Nova Nota Fiscal Direta</TextBlock>
                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Cliente *</TextBlock><ComboBox x:Name="CustomerComboBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Transportadora</TextBlock><ComboBox x:Name="CarrierComboBox"/></StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">Tipo Frete *</TextBlock>
                        <ComboBox x:Name="FreightTypeComboBox">
                            <ComboBoxItem Tag="CIF" IsSelected="True">CIF</ComboBoxItem>
                            <ComboBoxItem Tag="FOB">FOB</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock FontWeight="SemiBold">Cond. Pagamento *</TextBlock>
                        <ComboBox x:Name="PaymentTermComboBox">
                            <ComboBoxItem Tag="A_VISTA" IsSelected="True">A Vista</ComboBoxItem>
                            <ComboBoxItem Tag="30">30 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60">30/60 dias</ComboBoxItem>
                            <ComboBoxItem Tag="30/60/90">30/60/90 dias</ComboBoxItem>
                            <ComboBoxItem Tag="7/14/21/28">Semanal (7/14/21/28)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock>Produto</TextBlock><ComboBox x:Name="ProductComboBox" SelectionChanged="ProductComboBox_SelectionChanged"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Quantidade</TextBlock><TextBox x:Name="QuantityTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Unitario</TextBlock><TextBox x:Name="UnitPriceTextBox"/></StackPanel>
                    <StackPanel Margin="4" VerticalAlignment="Bottom"><Button Padding="10,6" Click="AddItemButton_Click">Adicionar Item</Button></StackPanel>
                </UniformGrid>

                <DataGrid x:Name="DraftItemsGrid" Margin="4,8,4,4" Height="100" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Unitario" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <UniformGrid Columns="4">
                    <StackPanel Margin="4"><TextBlock>Desconto (%)</TextBlock><TextBox x:Name="DiscountTextBox" Text="0" TextChanged="DiscountTextBox_TextChanged"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Frete (R$)</TextBlock><TextBox x:Name="FreightTextBox" Text="0" TextChanged="FreightTextBox_TextChanged"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Subtotal</TextBlock><TextBlock x:Name="SubtotalTextBlock" FontSize="14">0,00</TextBlock></StackPanel>
                    <StackPanel Margin="4"><TextBlock FontWeight="SemiBold">Total</TextBlock><TextBlock x:Name="TotalTextBlock" FontSize="14" Foreground="#1565C0">0,00</TextBlock></StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button x:Name="GenerateDirectInvoiceButton" Padding="12,6" Style="{StaticResource SuccessButton}" Click="GenerateDirectInvoiceButton_Click">Gerar Nota</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" Header="Pedidos liberados para faturamento" Margin="0,0,0,8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="ReadyOrdersGrid" SelectionMode="Single" SelectionChanged="ReadyOrdersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Number}" Width="90"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C2}" Width="130"/>
                        <DataGridTextColumn Header="Pagamento" Binding="{Binding PaymentTerm}" Width="120"/>
                        <DataGridTextColumn Header="Origem" Binding="{Binding SourceType}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="GeneratePanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="InvoiceActionHintTextBlock" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#2F4A5D"/>
                    <Button x:Name="CancelGenerateButton" Margin="0,0,8,0" Padding="12,6" Click="CancelGenerateButton_Click">Cancelar</Button>
                    <Button x:Name="GenerateInvoiceButton" Padding="12,6" Style="{StaticResource SuccessButton}" Click="GenerateInvoiceButton_Click">Gerar Nota Fiscal</Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Notas fiscais geradas">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="InvoicesGrid" SelectionChanged="InvoicesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NF" Binding="{Binding Number}" Width="90"/>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding OrderNumber}" Width="90"/>
                        <DataGridTextColumn Header="Origem" Binding="{Binding SourceType}" Width="90"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C2}" Width="130"/>
                        <DataGridTextColumn Header="Gerada em" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="PrintPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="Collapsed">
                    <Button x:Name="PrintInvoiceButton" Padding="12,6" Style="{StaticResource PrimaryButton}" Click="PrintInvoiceButton_Click" IsEnabled="False">Imprimir PDF</Button>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
