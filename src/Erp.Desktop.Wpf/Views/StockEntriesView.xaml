<UserControl x:Class="Erp.Desktop.Wpf.Views.StockEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#132A3A">Estoque - Entradas</TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Padding="14,6" Style="{StaticResource PrimaryButton}" Click="NewButton_Click">+ Novo</Button>
                <Button x:Name="EditButton" Margin="8,0,0,0" Padding="14,6" Click="EditButton_Click" IsEnabled="False">&#9998; Editar</Button>
            </StackPanel>
        </DockPanel>

        <Border x:Name="FormPanel" Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#F3F8FC" BorderBrush="#D6E1EA" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="#132A3A" Margin="0,0,0,6">Nova Entrada Manual</TextBlock>
                <UniformGrid Columns="3">
                    <StackPanel Margin="4"><TextBlock>Produto *</TextBlock><ComboBox x:Name="ProductComboBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Quantidade *</TextBlock><TextBox x:Name="QuantityTextBox"/></StackPanel>
                    <StackPanel Margin="4"><TextBlock>Observacao</TextBlock><TextBox x:Name="NotesTextBox"/></StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Margin="0,0,8,0" Padding="12,6" Click="CancelFormButton_Click">Cancelar</Button>
                    <Button Padding="12,6" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click">Salvar</Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="EntriesGrid" Margin="0,0,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="EntriesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Produto" Binding="{Binding ProductSku}" Width="180"/>
                <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity}" Width="120"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding SourceType}" Width="120"/>
                <DataGridTextColumn Header="Obs" Binding="{Binding Notes}" Width="240"/>
                <DataGridTextColumn Header="Data" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
